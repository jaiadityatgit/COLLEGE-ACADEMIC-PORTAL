PORT=5000
HOST=0.0.0.0
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/academic_portal?retryWrites=true&w=majority
JWT_SECRET=generate-a-secure-random-64-character-string
JWT_REFRESH_SECRET=generate-a-secure-random-64-character-string
REFRESH_TOKEN_SECRET=generate-a-secure-random-64-character-string
FRONTEND_URL=https://your-portal.vercel.app

# Storage Configuration (local for dev/persistent disk, or s3/r2 for production cloud storage)
STORAGE_PROVIDER=local

# Backend Development Environment Example
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (Leave blank for ephemeral in-memory, or provide local/Atlas URI)
MONGODB_URI=

# Authentication Secrets (Development defaults)
JWT_SECRET=dev-jwt-secret-key-change-in-production
JWT_REFRESH_SECRET=dev-refresh-jwt-secret-key-change-in-production

# Storage Provider (local | r2 | s3)
STORAGE_PROVIDER=local
UPLOAD_PATH=./uploads

# Backend Production Environment Example
PORT=5000
NODE_ENV=production

# Frontend Origin URL(s) for CORS & Cookies (comma-separated if multiple)
FRONTEND_URL=https://portal.yourdomain.com,https://your-frontend.vercel.app

# MongoDB Atlas Primary Datastore Connection String
# Replace <username>, <password>, and <cluster-url> with your Atlas cluster details
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/academic_portal?retryWrites=true&w=majority

# JWT Secrets (Generate with `openssl rand -hex 32`)
JWT_SECRET=replace-with-cryptographically-secure-32-byte-hex-secret
JWT_REFRESH_SECRET=replace-with-cryptographically-secure-32-byte-hex-refresh-secret

# Object Storage Configuration
# Set to 'r2' for Cloudflare R2, 's3' for AWS S3, or 'local'
STORAGE_PROVIDER=r2

# Option A: Cloudflare R2 Credentials (Recommended)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=portal-academic-files
R2_CUSTOM_DOMAIN=https://files.yourdomain.com

# Option B: AWS S3 Credentials (Alternative)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_BUCKET_NAME=portal-academic-files

# Upload Limits & Rate Limiting
UPLOAD_PATH=./uploads
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=150
